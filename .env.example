# ─── Supabase（可选，未配置则使用本地模式）───
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ─── 元数据抓取代理（可选，用于绕过抖音/小红书的 CORS 限制）───
# 开发期可留空：Vite dev server 自带 /api/meta 代理（服务端抓取，无 CORS 问题）。
# 生产环境建议部署 Supabase Edge Function（见 supabase/functions/fetch-meta），
# 并把该函数的 URL 填到下方：
VITE_METADATA_PROXY_URL=

# ─── fetch-meta Edge Function 侧配置（supabase secrets set，非 VITE_ 变量）───
# 生产必填：函数会校验用户 JWT（前端自动携带），并按下方白名单收紧 CORS。
# ALLOWED_ORIGINS= 逗号分隔的自有域名，例如：
# ALLOWED_ORIGINS=https://your-app.pages.dev,http://localhost:5173
